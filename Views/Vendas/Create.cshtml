@{
    ViewData["Title"] = "Nova Venda";
    var clientes = ViewBag.Clientes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var produtos = ViewBag.Produtos as List<SistemaVendasDoces.Models.Produto>;
}

<div class="container">
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">❌ @TempData["Erro"]</div>
    }

    <div class="card">
        <div class="card-header">
            💰 Registrar Nova Venda
        </div>
        <div class="card-body">

            <!-- PROMOÇÃO PÃO DE MEL -->
            <div class="promo-banner" style="background: linear-gradient(135deg, var(--pink-accent), var(--purple-bright)); border-radius: 12px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; text-align: center; box-shadow: 0 4px 15px rgba(232,139,167,0.3);">
                <span style="font-size: 1.3rem; font-weight: bold; color: #fff;">🍯 PROMOÇÃO PÃO DE MEL</span><br/>
                <span style="color: #fff; font-size: 1rem;">2 unidades por <strong>R$ 15,00</strong> · 3 unidades por <strong>R$ 23,00</strong></span>
            </div>
            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label class="form-label">👤 Cliente</label>
                    <select name="ClienteId" class="form-select" required>
                        <option value="">-- Selecione o Cliente --</option>
                        @if (clientes != null)
                        {
                            @foreach (var c in clientes)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">💳 Forma de Pagamento</label>
                    <select name="FormaPagamento" class="form-select" required>
                        <option value="Dinheiro">💵 Dinheiro</option>
                        <option value="PIX">📱 PIX</option>
                        <option value="Cartão Débito">💳 Cartão Débito</option>
                        <option value="Cartão Crédito">💳 Cartão Crédito</option>
                        <option value="Fiado">📝 Fiado</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">📝 Observações (opcional)</label>
                    <input type="text" name="Observacoes" class="form-control" placeholder="Ex: Entrega na casa da cliente" />
                </div>

                <hr style="border-color: var(--purple-primary);" />
                <h5 style="color: var(--purple-lightest);">🍬 Produtos da Venda</h5>

                <div id="itens-container">
                    <div class="item-row mb-3" style="background: rgba(255,255,255,0.03); border-radius: 10px; padding: 1rem; border: 1px solid var(--purple-primary);">
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Produto</label>
                                <select name="ProdutoIds" class="form-select produto-select" required onchange="atualizarPreco(this)">
                                    <option value="0">-- Selecione --</option>
                                    @if (produtos != null)
                                    {
                                        @foreach (var p in produtos)
                                        {
                                            <option value="@p.Id" data-preco="@p.PrecoVenda" data-estoque="@p.QuantidadeEstoque" data-nome="@p.Nome">
                                                @p.Nome - R$ @p.PrecoVenda.ToString("N2") (Est: @p.QuantidadeEstoque)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Qtd</label>
                                <input type="number" name="Quantidades" class="form-control qtd-input" value="1" min="1" required onchange="calcularTotal()" data-validate="integer" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Subtotal</label>
                                <span class="subtotal-display" style="display:block; font-size:1.1rem; font-weight:bold; color: var(--purple-lightest); padding: 0.5rem;">R$ 0,00</span>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="button" class="btn btn-info mb-3" onclick="adicionarItem()">
                    ➕ Adicionar mais um produto
                </button>

                <div style="background: linear-gradient(135deg, var(--purple-primary), var(--purple-bright)); border-radius: 12px; padding: 1.5rem; text-align: center; margin: 1rem 0;">
                    <h4 style="margin: 0;">💰 Total: <span id="total-geral">R$ 0,00</span></h4>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-success">✅ Finalizar Venda</button>
                    <a asp-action="Index" class="btn btn-secondary">↩️ Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var produtosOptions = document.querySelector('.produto-select').innerHTML;

    function adicionarItem() {
        var container = document.getElementById('itens-container');
        var div = document.createElement('div');
        div.className = 'item-row mb-3';
        div.style.cssText = 'background: rgba(255,255,255,0.03); border-radius: 10px; padding: 1rem; border: 1px solid var(--purple-primary);';
        div.innerHTML = `
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="form-label">Produto</label>
                    <select name="ProdutoIds" class="form-select produto-select" required onchange="atualizarPreco(this)">
                        ${produtosOptions}
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Qtd</label>
                    <input type="number" name="Quantidades" class="form-control qtd-input" value="1" min="1" required onchange="calcularTotal()" data-validate="integer" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">Subtotal</label>
                    <span class="subtotal-display" style="display:block; font-size:1.1rem; font-weight:bold; color: var(--purple-lightest); padding: 0.5rem;">R$ 0,00</span>
                </div>
            </div>
            <button type="button" class="btn btn-danger btn-sm mt-2" onclick="removerItem(this)">🗑️ Remover</button>
        `;
        container.appendChild(div);
    }

    function removerItem(btn) {
        btn.closest('.item-row').remove();
        calcularTotal();
    }

    function atualizarPreco(select) {
        calcularTotal();
    }

    function calcularPromoPaoDeMel(quantidade, precoUnitario) {
        if (quantidade <= 0) return 0;
        if (quantidade === 1) return precoUnitario;
        var total = 0;
        var restante = quantidade;
        var pacotes3 = Math.floor(restante / 3);
        restante -= pacotes3 * 3;
        total += pacotes3 * 23;
        var pacotes2 = Math.floor(restante / 2);
        restante -= pacotes2 * 2;
        total += pacotes2 * 15;
        total += restante * precoUnitario;
        var restante2 = quantidade;
        var total2 = 0;
        var p2 = Math.floor(restante2 / 2);
        restante2 -= p2 * 2;
        total2 += p2 * 15;
        total2 += restante2 * precoUnitario;
        return Math.min(total, total2);
    }

    function ehPaoDeMel(nome) {
        return nome && nome.toLowerCase().indexOf('pão de mel') >= 0;
    }

    function calcularTotal() {
        var total = 0;
        var rows = document.querySelectorAll('.item-row');
        rows.forEach(function(row) {
            var select = row.querySelector('.produto-select');
            var qtd = row.querySelector('.qtd-input');
            var display = row.querySelector('.subtotal-display');

            if (select.value && select.value !== '0' && qtd.value > 0) {
                var option = select.options[select.selectedIndex];
                var preco = parseFloat(option.getAttribute('data-preco').replace(',', '.')) || 0;
                var nome = option.getAttribute('data-nome') || '';
                var quantidade = parseInt(qtd.value);
                var subtotal;

                if (ehPaoDeMel(nome) && quantidade >= 2) {
                    subtotal = calcularPromoPaoDeMel(quantidade, preco);
                    var economia = (quantidade * preco) - subtotal;
                    display.innerHTML = 'R$ ' + subtotal.toFixed(2).replace('.', ',') + 
                        '<br><small style="color: var(--pink-accent); font-size: 0.75rem;">🍯 Promo! -R$' + economia.toFixed(2).replace('.', ',') + '</small>';
                } else {
                    subtotal = preco * quantidade;
                    display.textContent = 'R$ ' + subtotal.toFixed(2).replace('.', ',');
                }
                total += subtotal;
            } else {
                display.textContent = 'R$ 0,00';
            }
        });
        document.getElementById('total-geral').textContent = 'R$ ' + total.toFixed(2).replace('.', ',');
    }
</script>
}
