@{
    ViewData["Title"] = "Relatórios";
}

<div class="container">
    <div class="card">
        <div class="card-header">
            📊 Relatórios e Análises
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">🍬 Sabores Mais Vendidos</h5>
                            <p class="card-text">Veja quais produtos estão vendendo mais e gerando mais receita.</p>
                            <a asp-action="SaboresMaisVendidos" class="btn btn-primary">Ver Relatório</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">👥 Clientes Frequentes</h5>
                            <p class="card-text">Descubra quem são seus melhores clientes e quanto gastam.</p>
                            <a asp-action="ClientesFrequentes" class="btn btn-primary">Ver Relatório</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
