@model Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container">
    <div class="card">
        <div class="card-header">
            ✏️ Editar Cliente
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataCadastro" />

                <div class="form-group">
                    <label asp-for="Nome" class="form-label">Nome Completo *</label>
                    <input asp-for="Nome" class="form-control" data-validate="text" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Telefone" class="form-label">Telefone</label>
                    <input asp-for="Telefone" class="form-control" data-mask="phone" inputmode="tel" />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Endereco" class="form-label">Endereço</label>
                    <textarea asp-for="Endereco" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Endereco" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <input asp-for="Ativo" type="checkbox" /> Cliente Ativo
                    </label>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-success">💾 Salvar Alterações</button>
                    <a asp-action="Index" class="btn btn-secondary">↩️ Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
