@model Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container">
    <div class="card">
        <div class="card-header">
            ✏️ Editar Produto
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataCadastro" />

                <div class="form-group">
                    <label asp-for="Nome" class="form-label">Nome do Produto *</label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Descricao" class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PrecoVenda" class="form-label">Preço de Venda *</label>
                    <input asp-for="PrecoVenda" class="form-control" type="text" inputmode="decimal" placeholder="0,00" data-validate="number" />
                    <span asp-validation-for="PrecoVenda" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PrecoCusto" class="form-label">Preço de Custo</label>
                    <input asp-for="PrecoCusto" class="form-control" type="text" inputmode="decimal" placeholder="0,00" data-validate="number" />
                    <span asp-validation-for="PrecoCusto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="QuantidadeEstoque" class="form-label">Quantidade em Estoque *</label>
                    <input asp-for="QuantidadeEstoque" class="form-control" type="number" data-validate="integer" />
                    <span asp-validation-for="QuantidadeEstoque" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EstoqueMinimo" class="form-label">Estoque Mínimo</label>
                    <input asp-for="EstoqueMinimo" class="form-control" type="number" data-validate="integer" />
                    <span asp-validation-for="EstoqueMinimo" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <input asp-for="Ativo" type="checkbox" /> Produto Ativo
                    </label>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-success">💾 Salvar Alterações</button>
                    <a asp-action="Index" class="btn btn-secondary">↩️ Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
