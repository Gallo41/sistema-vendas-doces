@model Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="container">
    <div class="card">
        <div class="card-header" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);">
            🗑️ Confirmar Exclusão
        </div>
        <div class="card-body">
            <div class="alert alert-danger">
                <h3>⚠️ Atenção!</h3>
                <p>Você tem certeza que deseja excluir este produto?</p>
            </div>

            <h2 style="color: var(--purple-lightest);">@Model.Nome</h2>
            
            <div style="margin-top: 2rem;">
                <div class="form-group">
                    <strong>Preço de Venda:</strong> R$ @Model.PrecoVenda.ToString("N2")
                </div>
                <div class="form-group">
                    <strong>Estoque:</strong> @Model.QuantidadeEstoque unidades
                </div>
            </div>

            <form asp-action="Delete" method="post" style="margin-top: 2rem;">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">🗑️ Sim, Excluir</button>
                    <a asp-action="Index" class="btn btn-secondary">↩️ Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
